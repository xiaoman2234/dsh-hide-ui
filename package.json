{
  "name": "dsh-hide-ui",
  "version": "0.1.0",
  "description": "DSH plugin: hide all DSH UI so you can enjoy the wallpaper. Slash command: /hideui. Restore with Ctrl+Shift+H / Esc.",
  "type": "module",
  "main": "index.js",
  "keywords": ["dsh", "dsh-plugin", "hide-ui", "wallpaper", "zen", "fullscreen", "deepseek-harness"],
  "license": "MIT",
  "files": ["index.js", "client.js", "cordis.patch.yml", "cordis.yml", "README.md", "README.en.md", "LICENSE", "package.json"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=18" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  }
}
